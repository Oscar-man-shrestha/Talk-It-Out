# Copy to .env and fill in real values. Never commit .env.
# Postgres connection strings (docker-compose.yml uses these credentials on host port 5433).
DATABASE_URL=postgres://talkitout:<db-password>@localhost:5433/talkitout
TEST_DATABASE_URL=postgres://talkitout:<db-password>@localhost:5433/talkitout_test

# Secret used to sign JWT access tokens. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be set, at least 32 characters, and not start with '<'.
JWT_SECRET=<generate-a-long-random-secret>
# Access token lifetime (jsonwebtoken format).
JWT_EXPIRES_IN=7d

# HTTP port the API listens on.
PORT=3000

# Comma-separated list of allowed browser origins for the Flutter web build.
CORS_ORIGINS=http://127.0.0.1:52000,http://localhost:52000

# Run the stub rewrite worker in-process (true/false). The stub is a
# placeholder for the real NLP pipeline, not NLP itself.
RUN_STUB_WORKER=false

# Feed content analysis (Team 12 boundary). FEED_PROVIDER picks the provider
# adapter (only "fake" exists so far). RUN_FEED_WORKER runs the feed analysis
# worker loop in-process; it is independent of the groups stub worker.
FEED_PROVIDER=fake
RUN_FEED_WORKER=true

# Groups rewrite pipeline (see docs/groups-pipeline-contract.md).
# PIPELINE_MODE=stub runs the in-process stub worker (clearly NOT NLP);
# PIPELINE_MODE=external suppresses the stub and waits for the Python worker,
# which claims jobs at /internal/pipeline/* using X-Pipeline-Key.
# When PIPELINE_API_KEY is unset the internal pipeline API is disabled (503).
PIPELINE_MODE=stub
PIPELINE_API_KEY=<generate-a-long-random-secret-or-leave-unset-to-disable>
PIPELINE_MAX_INPUT_CHARS=5000
PIPELINE_MAX_OUTPUT_CHARS=8000
PIPELINE_LEASE_SECONDS=300
PIPELINE_MAX_ATTEMPTS=3

# --- Hardening (defaults shown) ---
# JSON body limit for every request (express format).
JSON_BODY_LIMIT=100kb
# Rate limits per IP. The stores are in-memory and per-process: running more
# than one API instance requires a shared store such as Redis.
RATE_LIMIT_GLOBAL=300      # public requests per minute
RATE_LIMIT_AUTH=10         # login+register attempts per 15 minutes
RATE_LIMIT_INTERNAL=600    # /internal/pipeline requests per minute
# '' = off; 'true' trusts one proxy hop; a number trusts that many hops.
TRUST_PROXY=
# PostgreSQL pool tuning.
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=15000
PG_CONNECT_TIMEOUT_MS=5000

# Password-reset email (API.md 38). disabled -> reset returns 503.
# smtp works with any provider; log prints the code to this console and is
# refused when NODE_ENV=production.
#
# Gmail (free): turn on 2-Step Verification, then Google Account ->
# Security -> App passwords -> create one. Paste it as SMTP_PASS (spaces
# are fine). Check it with: npm run mail:test -- you@gmail.com
MAIL_TRANSPORT=disabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# The project's official sender account.
SMTP_USER=talkitoutapp.mail@gmail.com
SMTP_PASS=
# Or one URL instead of the four lines above (takes precedence):
SMTP_URL=
# Defaults to SMTP_USER; Gmail requires sending from your own address.
MAIL_FROM=Talk It Out <talkitoutapp.mail@gmail.com>

# Sign in with Google (API.md 40): the Web OAuth client id(s) from Google
# Cloud Console, comma-separated. Empty -> /auth/google returns 503.
# Steps: docs/SETUP_GOOGLE_AND_EMAIL.md
GOOGLE_CLIENT_ID=
