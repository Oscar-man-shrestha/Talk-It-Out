# Settings for the root docker-compose.yml. Copy to .env (gitignored) and
# fill in real values. Never commit .env.

# Required. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Where people open the app and where their browser reaches the API.
WEB_ORIGIN=http://localhost:8080
API_PUBLIC_URL=http://localhost:3000
WEB_PORT=8080
API_PORT=3000

# Password-reset email (docs/SETUP_GOOGLE_AND_EMAIL.md). disabled -> 503.
MAIL_TRANSPORT=disabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Sign in with Google (docs/SETUP_GOOGLE_AND_EMAIL.md). Empty hides it.
GOOGLE_CLIENT_ID=

# Real AI rewrites: PIPELINE_MODE=external plus a running worker with the
# same PIPELINE_API_KEY (openssl rand -hex 32). stub = labeled placeholders.
PIPELINE_MODE=stub
RUN_STUB_WORKER=true
PIPELINE_API_KEY=

# Behind a TLS reverse proxy, set to the number of proxy hops (usually 1).
TRUST_PROXY=
