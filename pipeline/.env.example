# Copy to pipeline/.env and fill in real values. Never commit .env.
# Every name here is defined by this worker (see pipeline/README.md);
# PIPELINE_API_KEY must match the backend's PIPELINE_API_KEY.

# --- Backend connection (HTTP contract only; never a DB connection) ---
PIPELINE_BACKEND_BASE_URL=http://localhost:3000
PIPELINE_API_KEY=<generate-a-long-random-secret-matching-backend>

# Backend-side limits, mirrored for local guards. The backend defaults
# (5000/8000) are PROVISIONAL placeholders pending confirmation after
# consultation with Claude — do not treat them as final (README "Limits
# status").
PIPELINE_MAX_INPUT_CHARS=5000
PIPELINE_MAX_OUTPUT_CHARS=8000
PIPELINE_LEASE_SECONDS=300
PIPELINE_MAX_ATTEMPTS=3

# --- Worker loop ---
PIPELINE_POLL_INTERVAL_SECONDS=2

# --- Self-hosted, OpenAI-compatible inference (no third-party provider,
#     no provider API key; MODEL_API_KEY is only for a server that
#     requires auth) ---
MODEL_ENDPOINT=http://localhost:8080/v1/chat/completions
MODEL_ID=<todo-confirm-model-identifier>
MODEL_API_KEY=
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=1024
# Must be shorter than PIPELINE_LEASE_SECONDS so failures are reported
# before the backend re-claims the job.
MODEL_REQUEST_TIMEOUT_SECONDS=120
# Optional JSON object merged into every model request payload, for
# server-specific fields. For Qwen3 on vLLM, disable thinking output
# (thinking text otherwise pollutes the rewrite):
# MODEL_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Sent as pipeline_version on every successful result; bump when the
# model or prompt changes.
PIPELINE_VERSION=talkitout-pipeline 0.2.0
PIPELINE_LOG_LEVEL=INFO
